# Copy to .env and adjust
# Any Postgres connection string (Neon, Supabase, Vercel Postgres, or local)
DATABASE_URL="postgresql://user:password@host:5432/tirat?sslmode=require"
# Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"
SITE_URL="http://localhost:3000"
# Seeded accounts (development only) use this password
SEED_PASSWORD="TiratQA#2026"
# Optional sign-in with Google. Create an OAuth client (Web application) at https://console.cloud.google.com/apis/credentials
# and add this redirect URI:  <SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional sign-in with Telegram. Create a bot with @BotFather, then run /setdomain for your HTTPS domain.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# One-time price (ETB) for the paid learning levels 5 to 8. Defaults to 1500 when not set.
LEARN_ADVANCED_PRICE_ETB="1500"
# Testing only (ignored in production builds): "1" puts the correct quiz and exam answer in position A.
QUIZ_ANSWER_FIRST=""
